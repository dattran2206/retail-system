// Prisma Schema for Retail SaaS Platform Database
// Platform DB (public schema) - chứa tenants, plans, users global

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ================================================
// Platform-level Models (schema: public)
// ================================================

/// Gói dịch vụ (Free, Pro, Enterprise)
model Plan {
  id          String   @id @default(uuid())
  name        String   @unique // "FREE" | "PRO" | "ENTERPRISE"
  displayName String
  price       Decimal  @default(0) @db.Decimal(10, 2)
  features    Json     // Stored as JSON: maxUsers, maxProducts, etc.
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  tenants Tenant[]

  @@map("plans")
}

/// Tenant (store/business) trong hệ thống
model Tenant {
  id         String       @id @default(uuid())
  slug       String       @unique // subdomain identifier: "my-store"
  name       String
  schemaName String       @unique // PostgreSQL schema: "tenant_my_store"
  status     TenantStatus @default(PENDING)
  planId     String
  plan       Plan         @relation(fields: [planId], references: [id])

  // Contact & settings
  email    String?
  phone    String?
  address  String?
  settings Json?   @default("{}") // Tenant-specific settings

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]

  @@index([slug])
  @@index([status])
  @@map("tenants")
}

/// User trong hệ thống (global level)
model User {
  id           String   @id @default(uuid())
  email        String   @unique
  passwordHash String
  name         String
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true)
  tenantId     String
  tenant       Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  // Auth metadata
  lastLoginAt DateTime?
  refreshToken String?  @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@index([tenantId])
  @@map("users")
}

// ================================================
// Enums
// ================================================

enum TenantStatus {
  ACTIVE
  PENDING
  SUSPENDED
  DELETED
}

enum UserRole {
  SUPER_ADMIN
  TENANT_ADMIN
  MANAGER
  CASHIER
  VIEWER
}
